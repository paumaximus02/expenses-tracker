# Path to Gmail OAuth client secret JSON from Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials.json

# Alternative for Render/production: paste full OAuth client JSON (do not commit)
# GMAIL_CREDENTIALS_JSON={"installed":{...}}

# Stored OAuth token after first login (local file) or paste for headless/server use
GMAIL_TOKEN_PATH=token.json
# GMAIL_TOKEN_JSON={"token":"...","refresh_token":"...","token_uri":"...","client_id":"...","client_secret":"...","scopes":[...]}

# Citi Alerts from citibank.com / citi.com (after:YYYY/MM/DD for backfill start date)
GMAIL_SEARCH_QUERY=from:(citibank.com OR citi.com) after:2026/04/01 subject:transaction

# Map card last-four digits to household member names
CARD_HOLDERS=4149:Juan,1201:Debora

# SQLite database file
DATABASE_PATH=data/expenses.db

# Household timezone for default month filters and email date fallbacks (IANA name)
APP_TIMEZONE=America/New_York

# Web auth (set AUTH_DISABLED=1 locally to skip login)
# Production: use a strong random SECRET_KEY, AUTH_DISABLED=0, SESSION_COOKIE_SECURE=1 behind HTTPS
SECRET_KEY=change-me-in-production
AUTH_DISABLED=0
ALLOW_SIGNUP=1
SESSION_COOKIE_SECURE=0

# Auto-sync in the background when a logged-in page loads if last sync was longer ago than this (hours)
SYNC_STALE_HOURS=6

# Optional worker loop interval (seconds) for `python main.py worker`
SYNC_INTERVAL_SECONDS=3600

# Outbound notifications (email is off globally until NOTIFY_EMAIL_ENABLED=1; users opt in individually)
NOTIFICATIONS_ENABLED=1
NOTIFY_EMAIL_ENABLED=0
NOTIFY_EMAIL_POLICY=on_import
# Local testing: send email after every successful sync, even with zero new imports
# NOTIFY_EMAIL_DEBUG=1

# Public app URL for email links and Gmail OAuth redirect (required in production)
# APP_BASE_URL=https://your-app.onrender.com

# Protect POST /internal/sync-scheduled for Render cron (required in production)
# CRON_SECRET=generate-a-long-random-string

# Verbose per-message email query import logging (toggle without redeploy)
# EMAIL_QUERY_DEBUG=1

# SMTP (Render has no built-in mail; use Resend/Mailgun/SendGrid SMTP)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=expenses@example.com
# SMTP_USE_TLS=1

# For web Gmail connect, add this redirect URI in Google Cloud Console:
# http://127.0.0.1:5000/settings/gmail/callback
# Local HTTP OAuth is enabled automatically for http:// redirect URIs.
