# Path to Gmail OAuth client secret JSON from Google Cloud Console
GMAIL_CREDENTIALS_PATH=credentials.json

# Stored OAuth token after first login
GMAIL_TOKEN_PATH=token.json

# Citi Alerts from citibank.com / citi.com (after:YYYY/MM/DD for backfill start date)
GMAIL_SEARCH_QUERY=from:(citibank.com OR citi.com) after:2026/04/01 subject:transaction

# Map card last-four digits to household member names
CARD_HOLDERS=4149:Juan,1201:Debora

# SQLite database file
DATABASE_PATH=data/expenses.db

# Web auth (set AUTH_DISABLED=1 locally to skip login)
# Production: use a strong random SECRET_KEY, AUTH_DISABLED=0, SESSION_COOKIE_SECURE=1 behind HTTPS
SECRET_KEY=change-me-in-production
AUTH_DISABLED=0
ALLOW_SIGNUP=1
SESSION_COOKIE_SECURE=0

# Auto-sync on login only if last sync was longer ago than this (hours)
SYNC_STALE_HOURS=6

# For web Gmail connect, add this redirect URI in Google Cloud Console:
# http://127.0.0.1:5000/settings/gmail/callback
# Local HTTP OAuth is enabled automatically for http:// redirect URIs.
